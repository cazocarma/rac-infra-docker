# Solo desarrollo. Copiar a .env.dev; nunca usar estas claves en QA/PRD.
RAC_ENV=dev
HTTP_PORT=80
KEYCLOAK_PORT=8081
API_BASE_URL=http://localhost
KEYCLOAK_PUBLIC_URL=http://localhost:8081
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rentacompa
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_PASSWORD=keycloak
RABBITMQ_USER=rac-operator
RABBITMQ_PASSWORD=guest
OIDC_ISSUER=http://localhost:8081/realms/rentacompa
OIDC_WEB_REDIRECT_URI=http://localhost/redirect.html
MIGRATION_DB_USER=rac_migrator
MIGRATION_DB_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-local
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Secreto exclusivo de backend-user para activar el rol compa. Cambiar por ambiente.
COMPA_PROVISIONER_SECRET=dev-only-replace-me

# Credenciales independientes por proceso; en DEV: make database-init.
